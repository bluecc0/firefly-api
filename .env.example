# Server settings
PORT=3080
HOST=127.0.0.1

# Optional API key to protect this proxy server (leave empty to allow local unauthenticated access)
# Clients send: Authorization: Bearer <API_KEY>
API_KEY=

# Adobe Firefly credentials (at least one is required)
# RECOMMENDED: Sign in to https://firefly.adobe.com -> F12 -> Network -> firefly-3p.ff.adobe.io
# -> Request Headers -> Authorization -> copy the JWT after "Bearer " (starts with eyJ...)
ADOBE_FIREFLY_TOKEN=

# Optional: Full IMS Cookie header (from adobelogin.com / firefly.adobe.com) for session refresh & ARP
ADOBE_FIREFLY_COOKIE=

# Optional: Directory for cached Adobe Firefly sessions (default: ./.data)
DATA_DIR=./.data

# Optional: Minimum gap in ms between job submissions to reduce rate-limit risk (default: 12000)
# ADOBE_FIREFLY_MIN_SUBMIT_GAP_MS=12000
